# Frontend values only. Copy these lines to frontend/.env.local and set your Supabase values.
# Backend-only OpenAI configuration belongs in backend/.env (see backend/.env.example).
# Never put an OpenAI API key in a VITE_ variable or frontend environment file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
